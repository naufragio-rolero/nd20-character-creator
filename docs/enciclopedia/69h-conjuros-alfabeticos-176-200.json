      "nombre_literal": "Gracia de la fertilidad",
      "proveniencia": {
        "documento": "NaufragioD20 — Tomo de Magia [Orden alfabético]",
        "fuente_url": "https://docs.google.com/document/d/19hwP2K85Fo-HfThA9CBLQwCXxrl9ye0krcVLexLs5iM/edit",
